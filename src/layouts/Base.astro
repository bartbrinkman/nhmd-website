---
import '../styles/global.css';
import { asset } from '../utils';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'De Noord-Hollandse Modelspoordagen: een weekend lang modelspoorbanen van clubs uit de regio en een grote treinenbeurs, in Alkmaar.' } = Astro.props;
const currentPath = Astro.url.pathname;

const nav = [
  { href: asset('/'), label: 'Home' },
  { href: asset('/bezoek'), label: 'Bezoek' },
  { href: asset('/exposanten'), label: 'Exposanten' },
  { href: asset('/galerij'), label: 'Galerij' },
  { href: asset('/nieuws'), label: 'Nieuws' },
  { href: asset('/contact'), label: 'Contact' },
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <link rel="icon" type="image/x-icon" href={asset('/favicon.ico')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} | NH Modelspoordagen</title>
  </head>
  <body class="min-h-screen flex flex-col text-gray-800 font-sans">
    <!-- Header -->
    <header class="bg-primary text-white shadow-lg">
      <div class="max-w-6xl mx-auto px-4 py-3 md:py-4 flex items-center justify-between gap-3">
        <a href={asset('/')} class="flex items-center gap-3 min-w-0 hover:opacity-90 transition-opacity">
          <span class="shrink-0 font-heading font-black text-3xl md:text-4xl leading-none tracking-wide text-sein">NHMD</span>
          <div class="hidden sm:block min-w-0 border-l border-white/25 pl-3">
            <div class="text-sm sm:text-base leading-tight font-bold tracking-wide font-heading uppercase truncate">Noord-Hollandse Modelspoordagen</div>
            <div class="text-xs sm:text-sm text-white/70 truncate">Modelspoor en treinenbeurs in Alkmaar</div>
          </div>
        </a>

        <!-- Mobile menu button -->
        <button
          id="menu-toggle"
          class="md:hidden shrink-0 -mr-2 p-2.5 rounded-md hover:bg-white/10 transition-colors"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="menu-icon--open w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="menu-icon--close w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M6 18L18 6" />
          </svg>
        </button>

        <!-- Desktop nav -->
        <nav class="hidden md:flex gap-0.5 lg:gap-1" aria-label="Hoofdmenu">
          {nav.map(({ href, label }) => {
            const active = currentPath === href || (href !== asset('/') && currentPath.startsWith(href));
            return (
              <a
                href={href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'nav-link px-2.5 lg:px-3 py-2 text-sm font-medium transition-colors',
                  active ? 'nav-link--active text-white' : 'text-white/80 hover:text-white',
                ]}
              >
                {label}
              </a>
            );
          })}
        </nav>
      </div>

      <!-- Mobile nav -->
      <nav id="mobile-menu" class="md:hidden border-t border-white/10" aria-label="Hoofdmenu">
        <div>
          <div class="max-w-6xl mx-auto px-4 py-2 flex flex-col">
            {nav.map(({ href, label }) => {
              const active = currentPath === href || (href !== asset('/') && currentPath.startsWith(href));
              return (
                <a
                  href={href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'block px-3 py-3 rounded-md text-base font-medium transition-colors border-l-2',
                    active
                      ? 'border-sein bg-white/10 text-white'
                      : 'border-transparent text-white/80 hover:bg-white/10 hover:text-white',
                  ]}
                >
                  {label}
                </a>
              );
            })}
          </div>
        </div>
      </nav>

    </header>

    <!-- Main content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->

    <footer class="bg-primary-dark text-white/70 text-sm">
      <div class="max-w-6xl mx-auto px-4 py-10 md:py-12">
        <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4">
          <div class="md:col-span-2">
            <a href={asset('/')} class="inline-flex items-center gap-3 mb-3">
              <span class="font-heading font-black text-3xl leading-none tracking-wide text-sein">NHMD</span>
              <span class="font-heading font-extrabold uppercase text-white text-sm leading-tight border-l border-white/25 pl-3">Noord-Hollandse<br />Modelspoordagen</span>
            </a>
            <p class="max-w-sm">
              Een weekend lang modelspoorbanen van clubs uit Noord-Holland en een
              grote treinenbeurs, onder één dak.
            </p>
            <p class="mt-3">OSG Willem Blaeu<br />Robonsbosweg 11, 1816 MK Alkmaar</p>
          </div>
          <div>
            <div class="font-semibold text-white mb-3">Navigatie</div>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1.5 sm:block sm:space-y-1.5">
              {nav.map(({ href, label }) => (
                <a href={href} class="block hover:text-white transition-colors">{label}</a>
              ))}
            </div>
          </div>
          <div>
            <div class="font-semibold text-white mb-3">Meer</div>
            <div class="space-y-1.5">
              <a href={asset('/over')} class="block hover:text-white transition-colors">Over de NMD</a>
              <a href={asset('/deelnemen')} class="block hover:text-white transition-colors">Exposeren of standhouden</a>
            </div>
            <p class="mt-4"><a href="mailto:info@nhmd.nl" class="hover:text-white transition-colors break-all">info@nhmd.nl</a></p>
          </div>
        </div>
        <div class="mt-10 pt-4 border-t border-white/10 text-center text-xs text-white/50">
          &copy; {new Date().getFullYear()} Noord-Hollandse Modelspoordagen
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => {
        const open = menu?.classList.toggle('is-open') ?? false;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.querySelector('.menu-icon--open')?.classList.toggle('hidden', open);
        toggle.querySelector('.menu-icon--close')?.classList.toggle('hidden', !open);
      });
    </script>
  </body>
</html>
