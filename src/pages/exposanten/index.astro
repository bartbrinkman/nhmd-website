---
import Base from '../../layouts/Base.astro';
import LayoutCard from '../../components/LayoutCard.astro';
import exposanten from '../../content/exposanten.json';
import { asset } from '../../utils';

// Three groups, in the order a visitor cares about them: the gastbanen are the
// main draw, then the organising clubs' own banen, then the beurs. Within a
// group the order is that of exposanten.json.
const groups = [
  {
    category: 'gast',
    title: 'Gastbanen',
    intro: 'Naast de banen van de organiserende clubs komt er een groot aantal gastbanen naar Alkmaar, van clubs en bouwers van buiten de organisatie.',
  },
  {
    category: 'organisator',
    title: 'Banen van de organiserende clubs',
    intro: 'Vier modelspoorclubs uit Noord-Holland organiseren de Modelspoordagen samen, en komen elk met hun eigen banen.',
  },
  {
    category: 'beurs',
    title: 'Treinenbeurs en Lokdokter',
    intro: 'Kopen, verkopen en ruilen op de beurs, en gratis advies voor uw eigen locomotief.',
  },
].map(g => ({ ...g, items: exposanten.filter(e => e.category === g.category) }));
---

<Base title="Exposanten" description="Welke modelspoorbanen, clubs en standhouders zijn er te zien op de Noord-Hollandse Modelspoordagen?">
  <div class="bg-gradient-to-r from-primary-dark to-primary text-white py-12">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl md:text-5xl font-bold font-heading uppercase tracking-normal leading-tight">Exposanten</h1>
      <p class="mt-3 text-white/80 max-w-2xl">
        Ruim 150 meter modelspoor: een groot aantal gastbanen en de banen van
        de vier organiserende clubs. Daarnaast de treinenbeurs en de Lokdokter.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-8 md:py-12 space-y-12">
    {groups.filter(g => g.items.length > 0).map(g => (
      <section>
        <h2 class="section-title text-xl md:text-2xl font-bold font-heading uppercase text-primary mb-3">{g.title}</h2>
        <p class="text-gray-600 max-w-2xl mb-6">{g.intro}</p>
        <div class="grid gap-6 sm:grid-cols-2">
          {g.items.map((e) => (
            <LayoutCard title={e.title} href={e.href} scale={e.scale} description={e.description} status={e.status} image={e.image} />
          ))}
        </div>
      </section>
    ))}

    <div class="p-6 bg-white border border-gray-200 rounded-xl shadow-sm">
      <h2 class="font-heading uppercase text-lg font-bold text-primary mb-2">Zelf exposeren?</h2>
      <p class="text-gray-700">
        Heeft u een baan om te tonen, of wilt u een tafel op de beurs?
        Lees hoe u kunt <a href={asset('/deelnemen')} class="text-primary-light font-semibold">deelnemen</a>.
      </p>
    </div>
  </div>
</Base>
