---
import Base from '../../layouts/Base.astro';
import LayoutCard from '../../components/LayoutCard.astro';
import exposanten from '../../content/exposanten.json';
import { asset } from '../../utils';

const organisatoren = exposanten.filter(e => e.category === 'organisator');
const aanwezig = exposanten.filter(e => e.category === 'aanwezig');
---

<Base title="Exposanten" description="Welke modelspoorbanen, clubs en standhouders zijn er te zien op de Noord-Hollandse Modelspoordagen?">
  <div class="bg-gradient-to-r from-primary-dark to-primary text-white py-12">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl md:text-5xl font-bold font-heading uppercase tracking-normal leading-tight">Exposanten</h1>
      <p class="mt-3 text-white/80 max-w-2xl">
        Wie staat er op de Modelspoordagen? De vier organiserende clubs komen
        elk met hun eigen banen, aangevuld met gastbanen, de treinenbeurs en de
        Lokdokter.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-8 md:py-12">
    <h2 class="section-title text-xl md:text-2xl font-bold font-heading uppercase text-primary mb-6">Organiserende verenigingen</h2>
    <div class="grid gap-6 sm:grid-cols-2">
      {organisatoren.map((e) => (
        <LayoutCard title={e.title} href={e.href} scale={e.scale} description={e.description} status={e.status} image={e.image} />
      ))}
    </div>

    <h2 class="section-title text-xl md:text-2xl font-bold font-heading uppercase text-primary mt-12 mb-6">Ook aanwezig</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {aanwezig.map((e) => (
        <LayoutCard title={e.title} href={e.href} scale={e.scale} description={e.description} status={e.status} image={e.image} />
      ))}
    </div>

    <div class="mt-12 p-6 bg-white border border-gray-200 rounded-xl shadow-sm">
      <h2 class="font-heading uppercase text-lg font-bold text-primary mb-2">Zelf exposeren?</h2>
      <p class="text-gray-700">
        Heeft u een baan om te tonen, of wilt u een tafel op de beurs?
        Lees hoe u kunt <a href={asset('/deelnemen')} class="text-primary-light font-semibold">deelnemen</a>.
      </p>
    </div>
  </div>
</Base>
