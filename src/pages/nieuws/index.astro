---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { asset, months } from '../../utils';

const nieuws = (await getCollection('nieuws', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Nieuws" description="Nieuws over de Noord-Hollandse Modelspoordagen: voorbereidingen, terugblikken en aankondigingen.">
  <div class="bg-gradient-to-r from-primary-dark to-primary text-white py-12">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl md:text-5xl font-bold font-heading uppercase tracking-normal leading-tight">Nieuws</h1>
      <p class="mt-3 text-white/80 max-w-2xl">Voorbereidingen, terugblikken en aankondigingen.</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-8 md:py-12">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {nieuws.map((item) => {
        const d = item.data.date;
        return (
          <a href={asset(`/nieuws/${item.id}`)} class="group card card-hover bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:border-primary/30">
            {item.data.image ? (
              <img src={asset(item.data.image)} alt="" loading="lazy" decoding="async" class="h-44 w-full object-cover object-top" />
            ) : (
              <div class="h-44 bg-primary-dark flex items-center justify-center" aria-hidden="true">
                <span class="font-heading font-black text-5xl tracking-wide text-sein">NHMD</span>
              </div>
            )}
            <div class="card__body p-6">
              <time datetime={d.toISOString().slice(0, 10)} class="text-xs uppercase tracking-wide text-gray-500">
                {d.getDate()} {months[d.getMonth()]} {d.getFullYear()}
              </time>
              <h2 class="mt-1 font-semibold text-primary group-hover:text-primary-light transition-colors">{item.data.title}</h2>
              <p class="mt-2 mb-4 text-sm text-gray-600">{item.data.summary}</p>
              <span class="btn">Lees meer</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Base>
