---
// One event entry. Used at the foot of the page an event links to
// page, so both render from the same markup.
import DateBlock from './DateBlock.astro';
import { href as linkTo, isExternal, typeLabels, type EventItem } from '../utils';

interface Props {
  event: EventItem;
  /** Marks this as the soonest event. */
  isNext?: boolean;
  /** Suppress the link when the card already sits on the page it links to. */
  linked?: boolean;
}

const { event, isNext = false, linked = true } = Astro.props;
const type = event.type || 'overig';

const badgeClass =
  type === 'nmd' ? 'bg-primary text-white' :
  type === 'expositie' ? 'bg-sky-200 text-sky-900' :
  type === 'opendag' ? 'bg-amber-200 text-amber-900' :
  type === 'beurs' ? 'bg-violet-200 text-violet-900' :
  'bg-gray-200 text-gray-700';

const href = linked && event.link ? linkTo(event.link) : undefined;
const Tag = href ? 'a' : 'div';

const cardClass = [
  'bg-white rounded-xl p-5 sm:p-6 flex gap-4 shadow-sm',
  isNext ? 'border border-primary/40 ring-1 ring-primary/15' : 'border border-gray-200',
  !href ? '' : isNext ? 'group card-hover' : 'group card-hover hover:border-primary/30',
].filter(Boolean).join(' ');

const props = href
  ? { href, class: cardClass, ...(isExternal(href) && { target: '_blank', rel: 'noopener' }) }
  : { class: cardClass };
---

<Tag {...props}>
  <DateBlock date={event.date} endDate={event.endDate} />
  <div class="flex-1 min-w-0">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class={`inline-block px-2 py-0.5 rounded-full text-xs font-medium ${badgeClass}`}>{typeLabels[type]}</span>
    </div>
    <div class="font-semibold text-primary group-hover:text-primary-light transition-colors">{event.title}</div>
    {event.description && <p class="text-sm text-gray-600 mt-1">{event.description}</p>}
    {(event.startTime || event.endTime || event.location) && (
      <div class="text-xs text-gray-500 mt-2 flex flex-wrap gap-x-3">
        {event.location && (
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
            {event.location}
          </span>
        )}
        {(event.startTime || event.endTime) && (
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            {event.startTime}{event.startTime && event.endTime ? '–' : ''}{event.endTime}
          </span>
        )}
      </div>
    )}
  </div>
</Tag>
